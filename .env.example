# Placeholder-only file. Copy to .env and fill with development values. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local PostgreSQL 16, no password for a local trust-auth user.
DATABASE_URL=postgresql://chartnexa@localhost:5432/chartnexa_dev
DATABASE_POOL_MAX=10
# Generate with: openssl rand -hex 32  (minimum 32 characters)
CURSOR_SECRET=
# Used only by tests and the migration round trip to create scratch databases.
TEST_DATABASE_ADMIN_URL=postgresql://chartnexa@localhost:5432/postgres
# Auth: generate with openssl rand -hex 32 (minimum 32 characters)
ACCESS_TOKEN_SECRET=
# Optional: previous secret kept for one rotation window
ACCESS_TOKEN_SECRET_PREVIOUS=
# Staff two-step sign-in: 32 random bytes as base64, generate with: openssl rand -base64 32
# Leave empty in development (a clearly marked development key is used). REQUIRED in production,
# where the server refuses to start without a real key. Never commit a real value.
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90
# dev writes emails to .dev-mail/ (never in production); memory is for tests
MAILER_DRIVER=dev
APP_LINK_BASE=chartnexa://
# Files: local disk storage and no scanning are for development only; production refuses them.
STORAGE_DRIVER=local
STORAGE_DIR=.dev-storage
SCANNER=none
FILE_LINK_TTL_SECONDS=300
# Video: the test adapter (no transcoding) is for development only; production refuses it (Q09).
VIDEO_PROVIDER=test
VIDEO_LINK_TTL_SECONDS=14400
VIDEO_COMPLETION_PERCENT=90
# Payments run in test mode only; production refuses the test provider (ADR-0008).
# The test webhook secret has a development default; set your own of 32+ characters if needed.
PAYMENT_PROVIDER=test
# Live classes: staff paste a meeting link; students get it this many minutes before the start.
LIVE_PROVIDER=manual
LIVE_JOIN_OPENS_MINUTES=15
# Metrics: GET /metrics (Prometheus text). Open in development; in production it answers 404
# unless this is set, and then needs "Authorization: Bearer <token>". At least 32 characters.
METRICS_TOKEN=
# Only set true when behind a trusted proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Mobile app (public value only, never put a secret here). Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
