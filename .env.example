# Placeholder-only file. Copy to .env and fill with development values. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local PostgreSQL 16, no password for a local trust-auth user.
DATABASE_URL=postgresql://chartnexa@localhost:5432/chartnexa_dev
DATABASE_POOL_MAX=10
# Generate with: openssl rand -hex 32  (minimum 32 characters)
CURSOR_SECRET=
# Used only by tests and the migration round trip to create scratch databases.
TEST_DATABASE_ADMIN_URL=postgresql://chartnexa@localhost:5432/postgres
# Auth: generate with openssl rand -hex 32 (minimum 32 characters)
ACCESS_TOKEN_SECRET=
# Optional: previous secret kept for one rotation window
ACCESS_TOKEN_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90
# dev writes emails to .dev-mail/ (never in production); memory is for tests
MAILER_DRIVER=dev
APP_LINK_BASE=chartnexa://
# Only set true when behind a trusted proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Mobile app (public value only, never put a secret here). Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
