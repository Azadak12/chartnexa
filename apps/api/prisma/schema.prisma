generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Baseline marker proving the migration pipeline works. Product tables arrive in later changes.
model SchemaBaseline {
  id        Int      @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_baseline")
}
