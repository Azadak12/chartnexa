generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Baseline marker proving the migration pipeline works. Product tables arrive in later changes.
model SchemaBaseline {
  id        Int      @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_baseline")
}

enum UserStatus {
  active
  disabled
  deleted
}

enum OneTimeTokenType {
  email_verification
  password_reset
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?
  emailNormalized String?    @unique @map("email_normalized")
  passwordHash    String?    @map("password_hash")
  displayName     String?    @map("display_name")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  authzVersion    Int        @default(0) @map("authz_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions Session[]
  tokens   OneTimeToken[]
  roles    UserRole[]
  grants   InstructorGrant[]
  entitlements Entitlement[]
  completions  LessonCompletion[]
  mfaCredential MfaCredential?
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges MfaChallenge[]
  reviews        Review[]       @relation("ReviewAuthor")
  hiddenReviews  Review[]       @relation("ReviewHider")
  reviewReports  ReviewReport[] @relation("ReviewReporter")
  decidedAppeals ReviewAppeal[] @relation("ReviewAppealDecider")
  videoProgress  VideoProgress[]

  @@map("users")
}

model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshHash         String    @map("refresh_hash")
  previousRefreshHash String?   @map("previous_refresh_hash")
  rotatedAt           DateTime? @map("rotated_at") @db.Timestamptz(6)
  deviceLabel         String?   @map("device_label")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt          DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt   DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason       String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshHash])
  @@index([previousRefreshHash])
  @@index([userId])
  @@map("sessions")
}

model OneTimeToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      OneTimeTokenType
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("one_time_tokens")
}

model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

enum StaffRole {
  instructor
  manager
  admin
}

model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         StaffRole
  grantedBy    String?   @map("granted_by") @db.Uuid
  reason       String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

// Append-only: database triggers reject UPDATE, DELETE and TRUNCATE. No foreign keys, so
// records outlive account deletion. Holds ids and names only, never secrets or emails.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorKind   String   @map("actor_kind")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  outcome     String
  reason      String?
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("audit_events")
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseTone {
  blue
  black
  tint
}

enum CourseStatus {
  draft
  published
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String       @default("")
  level       CourseLevel
  priceCents  Int          @map("price_cents")
  coverTone   CourseTone   @default(blue) @map("cover_tone")
  status      CourseStatus @default(draft)
  /// Bumped on every change; edits must present the version they started from.
  version     Int          @default(1)
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  /// Stored totals, changed in the same transaction as every review (CHECKs are in the migration).
  ratingCount Int          @default(0) @map("rating_count")
  ratingSum   Int          @default(0) @map("rating_sum")
  /// Optional; a category in use cannot be deleted (RESTRICT).
  categoryId  String?      @map("category_id") @db.Uuid
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews     Review[]

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  grants InstructorGrant[]
  lessons Lesson[]
  modules CourseModule[]
  lessonKeys LessonCreateKey[]
  entitlements Entitlement[]

  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@map("courses")
}

/// One permission held by one Instructor, for one course (course_id set) or the whole academy
/// (create-course only). Ended rows stay as history. Partial unique index and CHECKs are in the
/// migration: one active grant per (user, permission, course); permission limited to the
/// grantable set; course_id null exactly when permission is course:create.
model InstructorGrant {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permission   String
  courseId     String?   @map("course_id") @db.Uuid
  /// manual (an Admin or Manager) or owner_auto (made when an Instructor creates a course).
  source       String    @default("manual")
  grantedBy    String?   @map("granted_by") @db.Uuid
  reason       String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user   User    @relation(fields: [userId], references: [id])
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId, revokedAt])
  @@index([courseId])
  @@map("instructor_grants")
}

/// A text lesson in one course. Positions run 1..N without gaps; the deferrable unique constraint
/// (course_id, position), the CHECKs and the cascade are in the migration, not declared here.
model Lesson {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String
  body      String   @default("")
  position  Int
  isPreview Boolean  @default(false) @map("is_preview")
  /// Bumped on every edit; edits must present the version they started from.
  version   Int      @default(1)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optional module of the same course (composite FK in the migration; deleting the module sets
  /// this to null and keeps the lesson).
  moduleId  String?  @map("module_id") @db.Uuid

  course Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module CourseModule?     @relation(fields: [moduleId, courseId], references: [id, courseId], onDelete: NoAction, map: "lessons_module_same_course_fkey")
  keys   LessonCreateKey[]
  completions LessonCompletion[]
  resources LessonResource[]
  uploads   UploadSession[]
  video     LessonVideo?
  videoProgress VideoProgress[]

  @@unique([id, courseId], map: "lessons_id_course_id_key")
  @@map("lessons")
}

/// Remembers which lesson a client-generated key created, so a retried add returns the same lesson.
model LessonCreateKey {
  courseId  String   @map("course_id") @db.Uuid
  key       String
  lessonId  String   @map("lesson_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([courseId, key])
  @@index([createdAt])
  @@map("lesson_create_keys")
}

/// One person's access to one course (ADR-0006). The status, source and reason CHECKs and the
/// partial unique index (one active row per user and course) are in the migration.
model Entitlement {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  /// Only admin_grant for now; payments add stripe, apple and google.
  source       String
  /// active or revoked. Revoked rows stay as history.
  status       String    @default("active")
  grantReason  String    @map("grant_reason")
  grantedBy    String?   @map("granted_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@map("entitlements")
}

/// A person has finished a lesson (a manual mark for text lessons). Created or deleted, never
/// changed. The composite foreign key proves the lesson belongs to the course; it cascades.
model LessonCompletion {
  userId      String   @map("user_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, courseId])
  @@map("lesson_completions")
}

/// A staff member's authenticator secret, encrypted with MFA_ENCRYPTION_KEY. A row exists only
/// once the first code was proven, so a row means two-step sign-in is on.
model MfaCredential {
  userId           String   @id @map("user_id") @db.Uuid
  secretCiphertext String   @map("secret_ciphertext")
  secretIv         String   @map("secret_iv")
  secretTag        String   @map("secret_tag")
  enabledAt        DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)
  /// The latest time step whose code was accepted; the same step can never be used twice.
  lastUsedStep     BigInt   @default(0) @map("last_used_step")

  user User @relation(fields: [userId], references: [id])

  @@map("mfa_credentials")
}

/// One-time codes for a lost phone. Only a hash is stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

/// The step between a correct password and a session. Only a hash of the token is stored; a setup
/// challenge also holds the not-yet-proven secret (encrypted). The CHECKs and the one-unused-per-
/// person-and-kind partial unique index are in the migration.
model MfaChallenge {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  kind              String
  tokenHash         String    @unique @map("token_hash")
  pendingCiphertext String?   @map("pending_ciphertext")
  pendingIv         String?   @map("pending_iv")
  pendingTag        String?   @map("pending_tag")
  attempts          Int       @default(0)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt            DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("mfa_challenges")
}

/// One person's rating and text for one course. One row per person and course (unique pair); the
/// rating range and text length CHECKs are in the migration.
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  rating    Int      @db.SmallInt
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Moderation: all set together, or all empty (CHECK in the migration). A hidden review keeps
  /// its text and is left out of public lists and the rating totals.
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenById   String?   @map("hidden_by") @db.Uuid
  hiddenReason String?   @map("hidden_reason")
  hiddenNote   String?   @map("hidden_note")

  user     User           @relation("ReviewAuthor", fields: [userId], references: [id])
  hiddenBy User?          @relation("ReviewHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reports  ReviewReport[]
  appeals  ReviewAppeal[]

  @@unique([userId, courseId])
  @@index([courseId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("reviews")
}

/// A person's report of a review. One open report per person and review (partial unique index in
/// the migration); a moderator's action resolves the open reports.
model ReviewReport {
  id         String    @id @default(uuid()) @db.Uuid
  reviewId   String    @map("review_id") @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  reason     String
  note       String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation("ReviewReporter", fields: [reporterId], references: [id])

  @@index([reviewId])
  @@index([reporterId])
  @@map("review_reports")
}

/// An author's appeal of one hiding (identified by the review and the time it was hidden).
model ReviewAppeal {
  id          String    @id @default(uuid()) @db.Uuid
  reviewId    String    @map("review_id") @db.Uuid
  hiddenAt    DateTime  @map("hidden_at") @db.Timestamptz(6)
  message     String
  status      String    @default("open")
  decidedById String?   @map("decided_by") @db.Uuid
  decidedNote String?   @map("decided_note")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("ReviewAppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, hiddenAt])
  @@map("review_appeals")
}

/// An academy-wide course category. Names are unique ignoring case (index in the migration).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Bumped on every rename; renames must present the version they started from.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses Course[]

  @@map("categories")
}

/// An ordered section of a course. Lesson positions stay the single reading order; the server
/// renumbers them so lessons are grouped by module order (lessons without a module first).
model CourseModule {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String
  position  Int
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([id, courseId], map: "course_modules_id_course_id_key")
  @@map("course_modules")
}

/// A file attached to a lesson. Bytes are in object storage under `storageKey` (server-made).
model LessonResource {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  lessonId     String   @map("lesson_id") @db.Uuid
  title        String
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  storageKey   String   @unique @map("storage_key")
  scanStatus   String   @map("scan_status")
  downloadable Boolean  @default(false)
  version      Int      @default(1)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Cascade, map: "lesson_resources_lesson_fkey")

  @@index([lessonId, createdAt, id], map: "lesson_resources_lesson_idx")
  @@map("lesson_resources")
}

/// An upload in progress. Parts are stored separately and assembled when it completes.
model UploadSession {
  id         String   @id @default(uuid()) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  createdBy  String?  @map("created_by") @db.Uuid
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  partSize   Int      @map("part_size")
  partCount  Int      @map("part_count")
  status     String   @default("open")
  /// "resource" (lesson file) or "video" (lesson video); limits differ (CHECK in the migration).
  purpose    String   @default("resource")
  resourceId String?  @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Cascade, map: "upload_sessions_lesson_fkey")

  @@map("upload_sessions")
}

/// A lesson's video (at most one). The bytes live with the video provider; `providerRef` is the
/// provider's id for it (the test adapter: an object storage key).
model LessonVideo {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  lessonId        String   @unique @map("lesson_id") @db.Uuid
  provider        String
  providerRef     String?  @map("provider_ref")
  status          String
  durationSeconds Int?     @map("duration_seconds")
  sizeBytes       Int?     @map("size_bytes")
  errorCode       String?  @map("error_code")
  version         Int      @default(1)
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Cascade, map: "lesson_videos_lesson_fkey")

  @@unique([lessonId, courseId], map: "lesson_videos_lesson_id_course_id_key")
  @@map("lesson_videos")
}

/// Watched time and last position of one person on one lesson's video.
model VideoProgress {
  userId          String   @map("user_id") @db.Uuid
  lessonId        String   @map("lesson_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  positionSeconds Int      @default(0) @map("position_seconds")
  watchedSeconds  Int      @default(0) @map("watched_seconds")
  lastBeatAt      DateTime @default(now()) @map("last_beat_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "video_progress_user_fkey")
  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Cascade, map: "video_progress_lesson_fkey")

  @@id([userId, lessonId])
  @@map("video_progress")
}
