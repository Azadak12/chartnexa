generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Baseline marker proving the migration pipeline works. Product tables arrive in later changes.
model SchemaBaseline {
  id        Int      @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_baseline")
}

enum UserStatus {
  active
  disabled
  deleted
}

enum OneTimeTokenType {
  email_verification
  password_reset
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?
  emailNormalized String?    @unique @map("email_normalized")
  passwordHash    String?    @map("password_hash")
  displayName     String?    @map("display_name")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  authzVersion    Int        @default(0) @map("authz_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions Session[]
  tokens   OneTimeToken[]
  roles    UserRole[]
  grants   InstructorGrant[]

  @@map("users")
}

model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshHash         String    @map("refresh_hash")
  previousRefreshHash String?   @map("previous_refresh_hash")
  rotatedAt           DateTime? @map("rotated_at") @db.Timestamptz(6)
  deviceLabel         String?   @map("device_label")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt          DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt   DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason       String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshHash])
  @@index([previousRefreshHash])
  @@index([userId])
  @@map("sessions")
}

model OneTimeToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      OneTimeTokenType
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("one_time_tokens")
}

model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

enum StaffRole {
  instructor
  manager
  admin
}

model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         StaffRole
  grantedBy    String?   @map("granted_by") @db.Uuid
  reason       String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

// Append-only: database triggers reject UPDATE, DELETE and TRUNCATE. No foreign keys, so
// records outlive account deletion. Holds ids and names only, never secrets or emails.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorKind   String   @map("actor_kind")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  outcome     String
  reason      String?
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("audit_events")
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseTone {
  blue
  black
  tint
}

enum CourseStatus {
  draft
  published
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String       @default("")
  level       CourseLevel
  priceCents  Int          @map("price_cents")
  coverTone   CourseTone   @default(blue) @map("cover_tone")
  status      CourseStatus @default(draft)
  /// Bumped on every change; edits must present the version they started from.
  version     Int          @default(1)
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  grants InstructorGrant[]

  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@map("courses")
}

/// One permission held by one Instructor, for one course (course_id set) or the whole academy
/// (create-course only). Ended rows stay as history. Partial unique index and CHECKs are in the
/// migration: one active grant per (user, permission, course); permission limited to the
/// grantable set; course_id null exactly when permission is course:create.
model InstructorGrant {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permission   String
  courseId     String?   @map("course_id") @db.Uuid
  /// manual (an Admin or Manager) or owner_auto (made when an Instructor creates a course).
  source       String    @default("manual")
  grantedBy    String?   @map("granted_by") @db.Uuid
  reason       String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user   User    @relation(fields: [userId], references: [id])
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId, revokedAt])
  @@index([courseId])
  @@map("instructor_grants")
}
