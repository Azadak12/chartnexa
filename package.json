{
  "name": "chartnexa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "secrets": "secretlint \"**/*\"",
    "audit:deps": "pnpm audit --audit-level high",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm build && pnpm secrets",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^10.0.0",
    "eslint": "^10.0.0",
    "lefthook": "^1.0.0",
    "prettier": "^3.0.0",
    "secretlint": "^10.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
